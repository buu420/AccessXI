      "expect": "mesh-proven",
      "request": {
        "start": {"x": 0.0, "z": 0.0, "y": 0.0},
        "end": {"x": 1.0, "z": 0.0, "y": 0.0}
      },
      "observation": {
        "status": "exact-path",
        "start_valid": true,
        "end_valid": true,
        "fallback_used": false,
        "waypoint_count": 2,
        "waypoints": [
          {"x": 0.0, "z": 0.0, "y": 0.0, "clearance": 1.0},
          {"x": 1.0, "z": 0.0, "y": 0.0, "clearance": 1.0}
        ],
        "first_endpoint_error": 0.0,
        "last_endpoint_error": 0.0,
        "start_clearance": 1.0,
        "end_clearance": 1.0,
        "minimum_waypoint_clearance": 1.0,
        "path_length": 1.0
      }
    },
