<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AccessXIInstaller</AssemblyName>
    <RootNamespace>AccessXIInstaller</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\dist\AccessXI-Ashita-Reloaded-Installer.zip">
      <LogicalName>Payload.AccessXI-Ashita-Reloaded-Installer.zip</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
